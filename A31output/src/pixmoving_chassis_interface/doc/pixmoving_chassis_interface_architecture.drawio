    <diagram id="code-responsibilities" name="Code Responsibilities">
        <mxGraphModel dx="2478" dy="1234" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="cr_title" value="源码职责图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="30" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="cr_subtitle" value="把主要 .cpp / .hpp 文件和它们负责的语义拆开看，更容易定位“这个包里哪段代码该改什么问题” 。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#4B5563;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="30" y="62" width="1200" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="cr_left_frame" value="运行壳层 / 共享定义" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B0BEC5;fillColor=#F8FBFF;strokeWidth=2;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="30" y="120" width="660" height="1160" as="geometry"/>
                </mxCell>
                <mxCell id="cr_left_common" value="&lt;b&gt;include/pixmoving_chassis_interface/pixmoving_chassis_interface.hpp&lt;/b&gt;&lt;br&gt;节点类、成员缓存、订阅/发布/定时器/clients 声明、task semantic 状态、里程融合状态、mode 参数等全都在这里汇总。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#455A64;fillColor=#ECEFF1;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="70" y="180" width="580" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="cr_left_utils" value="&lt;b&gt;chassis_interface_common.hpp / .cpp&lt;/b&gt;&lt;br&gt;DriveMode 枚举、topic/service/pub 常量、driveModeToString()、yaw / distance 等基础工具。当前 mode=12 也在这里完成对外文案映射。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#546E7A;fillColor=#F5F7FA;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="70" y="390" width="580" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="cr_left_runtime" value="&lt;b&gt;src/pixmoving_chassis_interface.cpp&lt;/b&gt;&lt;br&gt;- initParameters() 读取站点文件、snapshot、阈值、状态机参数&lt;br&gt;- initSubscriptions() / initPublishers() / initTimers()&lt;br&gt;- onTimer() 统一发布、保存 snapshot、调用 updateFusedPowerOnMileage()&lt;br&gt;- 也是 ROS clients 和 callback groups 的装配点" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1A73E8;fillColor=#DCEBFF;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="70" y="600" width="580" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="cr_left_main" value="&lt;b&gt;src/pixmoving_chassis_interface_node.cpp&lt;/b&gt;&lt;br&gt;main() 只做 rclcpp::init()、构造节点、SingleThreadedExecutor::spin()。&lt;br&gt;&lt;br&gt;这意味着运行期真正的业务逻辑全部都回到 Node 类方法里。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#90CAF9;fillColor=#EDF6FF;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="70" y="890" width="580" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="cr_left_cache" value="&lt;b&gt;共享缓存视角&lt;/b&gt;&lt;br&gt;所有功能切片最终都写回同一批成员：vehicle_info_msg_ / sensor_info_msg_ / autoware_info_msg_ / v2d_current_station_info_msg_ / task_semantic_status_msg_。&lt;br&gt;&lt;br&gt;所以这个包的本质不是“算法彼此独立”，而是“多个回调共同维护一份语义缓存” 。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#607D8B;fillColor=#F8FAFB;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="70" y="1090" width="580" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="cr_mid_frame" value="状态 / 语义主链路" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B0BEC5;fillColor=#FCFDFE;strokeWidth=2;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="750" y="120" width="660" height="1160" as="geometry"/>
                </mxCell>
                <mxCell id="cr_mid_task" value="&lt;b&gt;src/pixmoving_task.cpp&lt;/b&gt;&lt;br&gt;- readStationYamlFile() / publishAllStationInfo()&lt;br&gt;- onLaneletRoute(): 站点推断、new_task / replan 判定、异步 route length 请求&lt;br&gt;- latchTaskSemantic() / shouldTreatAsNewTask() / markTaskTerminal()&lt;br&gt;- refreshTaskSemanticStatusSummary() 输出 /app/display/debug/task_semantic_status" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7E57C2;fillColor=#F1EAFE;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="790" y="180" width="580" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="cr_mid_autoware_old" value="&lt;b&gt;src/pixmoving_autoware.cpp&lt;/b&gt;&lt;br&gt;- 原始 if/else 驾驶模式逻辑&lt;br&gt;- remaining_distance / estimate_time 回写&lt;br&gt;- control_mode / operation_mode / emergency / velocity / pose 相关回调&lt;br&gt;- 现在仍保留为 fallback，保证 use_state_machine_drive_mode=false 时可回退" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F48FB1;fillColor=#FFF0F6;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="790" y="490" width="580" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="cr_mid_autoware_sm" value="&lt;b&gt;src/pixmoving_autoware_state_machine.cpp&lt;/b&gt;&lt;br&gt;&lt;b&gt;src/pixmoving_drive_mode.cpp&lt;/b&gt;&lt;br&gt;&lt;b&gt;include/drive_mode_state_machine.hpp&lt;/b&gt;&lt;br&gt;&lt;br&gt;- 把 node 成员封装成 DriveModeContext&lt;br&gt;- DriveModeManager::update() 内部派发 Autoware / time / vehicle / new_task 事件&lt;br&gt;- SML 负责状态迁移、mode 输出、mode=12 短暂保持后回退 estop&lt;br&gt;- onAutowareStateWithStateMachine() 负责同步 mode、nearby_finish、task terminal" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C2185B;fillColor=#FDE7EF;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="790" y="730" width="580" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="cr_mid_note" value="&lt;b&gt;主线关系&lt;/b&gt;&lt;br&gt;task.cpp 决定任务语义；状态机只消费显式 new_task_received，不再自己猜测。&lt;br&gt;&lt;br&gt;这就是为什么当前包能同时稳定展示 A-&gt;F 任务语义，又保持 mode 迁移可控。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#AD1457;fillColor=#FFF7FA;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="790" y="1090" width="580" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="cr_right_frame" value="采集 / 融合 / 后处理" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B0BEC5;fillColor=#F8FBFF;strokeWidth=2;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="120" width="660" height="1160" as="geometry"/>
                </mxCell>
                <mxCell id="cr_right_chassis" value="&lt;b&gt;src/pixmoving_chassis.cpp&lt;/b&gt;&lt;br&gt;- 对接底盘 driver 话题，更新门/灯/档位/电池/速度/座椅/AEB/VIN/VCU 版本&lt;br&gt;- 提供 is_estop_、vcu_brake_pedal_req_fb_、latest_raw_can_trip_m_ 等内部状态&lt;br&gt;- 是 vehicle_info_msg_ 最主要的字段填充源" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#EF6C00;fillColor=#FFF0E0;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="180" width="580" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="cr_right_sensor" value="&lt;b&gt;src/pixmoving_sensor.cpp&lt;/b&gt;&lt;br&gt;只负责 GNSS fix / heading / satellite count 到 sensor_info_msg_ 的转换，逻辑相对纯粹。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#26A69A;fillColor=#E8F7F5;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="430" width="580" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="cr_right_mileage" value="&lt;b&gt;src/pixmoving_mileage.cpp&lt;/b&gt;&lt;br&gt;- chooseMileageSource(): NDT -&gt; GNSS -&gt; CHASSIS_SPEED&lt;br&gt;- accumulateFromNdt() / accumulateFromGnss() / accumulateFromChassisSpeed()&lt;br&gt;- resetMileageAnchorForSource() / syncPowerCycleResetByRawTrip()&lt;br&gt;- updateFusedPowerOnMileage() 最终写回 vehicle_info_msg_.ptm" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FB8C00;fillColor=#FFF5E8;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="600" width="580" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="cr_right_metrics" value="&lt;b&gt;planning_metrics_monitor.cpp / .hpp&lt;/b&gt;&lt;br&gt;- 独立子组件，不走 onTimer()&lt;br&gt;- 消费 planning_evaluator 的 MetricArray&lt;br&gt;- 计算 comfort_level / stability_level 并立即发布 PlanningMetrics" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3949AB;fillColor=#E9EDFF;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="880" width="580" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="cr_right_outputs" value="&lt;b&gt;谁真正对外输出&lt;/b&gt;&lt;br&gt;- onTimer(): 大多数 display / cloud_control_platform 主题&lt;br&gt;- onAutowareState*(): current_station_info + nearby_finish&lt;br&gt;- PlanningMetricsMonitor: planning_metrics&lt;br&gt;&lt;br&gt;从代码责任看，&#39;发布&#39; 并不是某个独立文件的工作，而是由运行壳层 + 状态机 + monitor 共同完成。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#607D8B;fillColor=#F5F7FA;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="1090" width="580" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e1" value="shared members / utils" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#607D8B;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cr_left_common" target="cr_mid_task" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e2" value="shared members / utils" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#607D8B;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cr_left_common" target="cr_mid_autoware_sm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e3" value="pending_new_task_event_ / markTaskTerminal()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cr_mid_task" target="cr_mid_autoware_sm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e4" value="is_estop_ / brake / speed / raw trip" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF6C00;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cr_right_chassis" target="cr_mid_autoware_sm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e5" value="GNSS fixes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#26A69A;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cr_right_sensor" target="cr_right_mileage" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e6" value="timer / publish / snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1A73E8;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cr_left_runtime" target="cr_right_outputs" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="critical-semantics" name="Critical Semantics">
        <mxGraphModel dx="1304" dy="649" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="cs_title" value="关键机制与语义边界" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="30" y="20" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="cs_subtitle" value="这一页专门总结最容易影响业务结果、排障和图表理解的 4 条机制：任务语义、驾驶模式、里程融合、发布节奏。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#4B5563;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="30" y="62" width="1500" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="cs_task" value="&lt;b&gt;A. route -&gt; 任务语义锁存&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 优先请求 route station service 推断 current / target station&lt;br&gt;2. 服务失败再回退到 pose matching fallback&lt;br&gt;3. shouldTreatAsNewTask() 只看：是否已有语义、上一任务是否终态、目标站是否变化&lt;br&gt;4. 新任务时 latchTaskSemantic() + 重置 travel_distance + 重新计算 route length&lt;br&gt;5. 重规划时继续沿用锁存语义，避免 A-&gt;F 被中途改写成 C-&gt;F" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7E57C2;fillColor=#F1EAFE;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacing=16;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="70" y="170" width="460" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="cs_mode" value="&lt;b&gt;B. 驾驶模式状态机&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Context 由 autoware_state、speed、target_distance、brake、decentralization、is_estop、has_active_task 等组成&lt;br&gt;2. DriveModeManager 内部派发 Autoware / time / vehicle / new_task 事件&lt;br&gt;3. 统一维护 Manual / Standby / Executing / Takeover / Done / Cancel / EmergencyStop&lt;br&gt;4. 当前新增 mode=12 AutoDoneEstopNear：终点附近急停时先发短暂收尾态，再回退到 EmergencyStop&lt;br&gt;5. mode 变化还会触发 nearby_finish 和 task_terminal 联动" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C2185B;fillColor=#FDE7EF;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacing=16;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="600" y="170" width="460" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="cs_mileage" value="&lt;b&gt;C. ptm 里程融合&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. chooseMileageSource(): NDT -&gt; GNSS -&gt; CHASSIS_SPEED&lt;br&gt;2. 每层只提供增量 delta_m，不直接覆盖累计值&lt;br&gt;3. freshness / warmup / jump reject / speed consistency 控制异常漂移&lt;br&gt;4. syncPowerCycleResetByRawTrip() 保证 ptm 仍然保持上电里程语义&lt;br&gt;5. snapshot restore / save 让节点重启后 ptm 不突变" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FB8C00;fillColor=#FFF5E8;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacing=16;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="180" width="460" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="cs_publish" value="&lt;b&gt;D. 发布节奏与可靠性&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. onTimer() 按 loop_rate 周期发布 display / vehicle / sensor / autoware / task_semantic_status&lt;br&gt;2. vehicle_info 只有 live-source ready 后才会对外发，避免占位垃圾值&lt;br&gt;3. current_station_info 不是固定 10 Hz，而是在 Autoware 关键状态路径里发布&lt;br&gt;4. planning_metrics 由 PlanningMetricsMonitor 事件驱动发布，不依赖 timer&lt;br&gt;5. 所有对外结果都来自共享缓存，所以排障时要把“谁先写、谁后写”一起看" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#546E7A;fillColor=#ECEFF1;strokeWidth=2;fontSize=19;align=left;verticalAlign=top;spacing=16;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1660" y="170" width="460" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="cs_note" value="&lt;b&gt;一句话总结&lt;/b&gt;&lt;br&gt;pixmoving_chassis_interface 真正提供的不是“底盘原始 topic”，而是 4 种稳定后的业务语义：&lt;br&gt;稳定的任务起终点、稳定的驾驶模式、稳定的上电里程、稳定的发布策略。&lt;br&gt;&lt;br&gt;因此改动这个包时，最需要关注的是语义兼容，而不是单个字段值本身。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#607D8B;fillColor=#F5F7FA;strokeWidth=2;fontSize=21;align=left;verticalAlign=top;spacing=18;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="260" y="770" width="1670" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="cs_e1" value="new_task_received / markTaskTerminal()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cs_task" target="cs_mode" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cs_e2" value="vehicle_info.mode / task_terminal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#546E7A;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cs_mode" target="cs_publish" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1360" y="470"/>
                            <mxPoint x="1360" y="470"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cs_e3" value="vehicle_info.ptm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FB8C00;endArrow=block;endFill=1;fontSize=14;fontFamily=Noto Sans JP;" parent="1" source="cs_mileage" target="cs_publish" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>