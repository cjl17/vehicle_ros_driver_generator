                <mxCell id="rt_title" value="pixmoving_chassis_interface 运行架构图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="30" y="20" width="900" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="rt_subtitle" value="Updated 2026-04-02 | 以当前代码实现为准：单 ROS 2 节点 + 1 个 PlanningMetricsMonitor 子组件。图中重点展示输入、回调分组、核心处理切片、输出与调试面。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#4B5563;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="30" y="62" width="1650" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="rt_meta" value="&lt;b&gt;Package&lt;/b&gt;: ament_cmake shared lib + executable&lt;br&gt;&lt;b&gt;Main&lt;/b&gt;: chassis_interface_node + SingleThreadedExecutor&lt;br&gt;&lt;b&gt;Timer&lt;/b&gt;: loop_rate, default 10 Hz&lt;br&gt;&lt;b&gt;Drive Mode&lt;/b&gt;: use_state_machine_drive_mode default true" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#90A4AE;fillColor=#F7FAFC;strokeWidth=2;fontSize=16;align=left;verticalAlign=top;spacing=12;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1690" y="20" width="470" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="rt_input_frame" value="外部输入与配置" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B0BEC5;fillColor=#F8FBFF;strokeWidth=2;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="30" y="120" width="360" height="1150" as="geometry"/>
                </mxCell>
                <mxCell id="rt_input_autoware" value="&lt;b&gt;Autoware / Planning topics&lt;/b&gt;&lt;br&gt;goal, route, autoware_state&lt;br&gt;mission_remaining_distance_time&lt;br&gt;velocity_limit, velocity_report&lt;br&gt;localization_pose, pos_q&lt;br&gt;operation_mode, control_mode, emergency&lt;br&gt;&lt;br&gt;主要进入 onLaneletRoute()、onAutowareState*()、onControlModeReport() 等回调" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4A90E2;fillColor=#EAF3FF;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="60" y="180" width="300" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="rt_input_sensor" value="&lt;b&gt;GNSS / Sensor topics&lt;/b&gt;&lt;br&gt;fix, heading&lt;br&gt;main / auxiliary satellite count&lt;br&gt;&lt;br&gt;用于 sensor_info 展示，也给里程融合提供 GNSS 输入" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#26A69A;fillColor=#E8F7F5;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="60" y="470" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="rt_input_driver" value="&lt;b&gt;Pix Driver / CAN / AEB topics&lt;/b&gt;&lt;br&gt;BCM / Drive / Brake / Steer / Power / Vehicle / Odo&lt;br&gt;VIN / VCU transfer / errcode / tire pressure&lt;br&gt;AebInfoReport&lt;br&gt;&lt;br&gt;是 VehicleInfo 原始字段、急停状态、底盘速度和原始 trip 的主要来源" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FB8C00;fillColor=#FFF3E6;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="60" y="650" width="300" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="rt_input_cfg" value="&lt;b&gt;本地配置 + service clients&lt;/b&gt;&lt;br&gt;launch 参数 / chassis_interface.yml&lt;br&gt;stations.yaml / vehicle_info snapshot bin&lt;br&gt;&lt;br&gt;clients:&lt;br&gt;- /cloud_control_platform/get_route_stations&lt;br&gt;- /cloud_control_platform/get_lenght/from_lanelet" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8D6E63;fillColor=#F7EFEA;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="60" y="960" width="300" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_frame" value="节点内部运行时" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B0BEC5;fillColor=#FCFDFE;strokeWidth=2;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="430" y="120" width="1080" height="1150" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_shell" value="&lt;b&gt;PixmovingChassisInterfaceNode&lt;/b&gt;&lt;br&gt;构造时依次执行 initParameters() / initSubscriptions() / initPublishers() / initTimers() / publishAllStationInfo()。&lt;br&gt;虽然创建了 3 个 Reentrant callback groups，但 main 当前仍用 SingleThreadedExecutor；service client 均为异步调用。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1A73E8;fillColor=#DCEBFF;strokeWidth=2;fontSize=20;fontStyle=1;align=left;verticalAlign=top;spacing=16;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="470" y="180" width="1000" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_groups" value="&lt;b&gt;回调分组 / 调度面&lt;/b&gt;&lt;br&gt;autoware_callback_group_: goal / route / state / emergency / control_mode / operation_mode / pose&lt;br&gt;sensor_callback_group_: GNSS / heading / satellite_count&lt;br&gt;driver_callback_group_: CAN / AEB / ODO / VIN / battery / door / light / brake / speed" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#607D8B;fillColor=#EEF3F7;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="470" y="320" width="1000" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_task" value="&lt;b&gt;1. 任务语义与站点推断&lt;/b&gt;&lt;br&gt;src/pixmoving_task.cpp&lt;br&gt;&lt;br&gt;- 读取 stations.yaml 并发布 all_station_info&lt;br&gt;- route station service 优先，pose matching fallback 兜底&lt;br&gt;- 锁存 semantic origin / target，区分 new_task / replan&lt;br&gt;- 异步请求 route length，更新 task_distance / target_distance&lt;br&gt;- 刷新 task_semantic_status / task_terminal" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7E57C2;fillColor=#F1EAFE;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="470" y="460" width="300" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_mode" value="&lt;b&gt;2. Autoware + 驾驶模式状态机&lt;/b&gt;&lt;br&gt;src/pixmoving_autoware_state_machine.cpp&lt;br&gt;src/pixmoving_drive_mode.cpp&lt;br&gt;include/drive_mode_state_machine.hpp&lt;br&gt;&lt;br&gt;- 根据 autoware_state / brake / estop / 放权 / new_task_received 生成 mode&lt;br&gt;- 默认启用 SML 状态机；旧 if/else 逻辑保留在 pixmoving_autoware.cpp&lt;br&gt;- 统一输出 vehicle_info.mode / nearby_finish / task terminal&lt;br&gt;- 当前包含 mode=12 终点附近急停结束" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C2185B;fillColor=#FDE7EF;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="805" y="460" width="300" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_chassis" value="&lt;b&gt;3. 底盘 / CAN 聚合&lt;/b&gt;&lt;br&gt;src/pixmoving_chassis.cpp&lt;br&gt;&lt;br&gt;- 门、灯、安全带、档位、电池、AEB、VIN、VCU 版本&lt;br&gt;- 车速 / 刹车 / 原始里程 / 急停反馈&lt;br&gt;- 写回 vehicle_info_msg_ / v2d_vehicle_info_msg_&lt;br&gt;- 提供 is_estop_、vcu_brake_pedal_req_fb_、latest_raw_can_trip_m_ 等内部状态" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#EF6C00;fillColor=#FFF0E0;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="460" width="300" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_sensor" value="&lt;b&gt;4. GNSS / 传感器状态聚合&lt;/b&gt;&lt;br&gt;src/pixmoving_sensor.cpp&lt;br&gt;&lt;br&gt;- NavSatFix / heading / satellite count&lt;br&gt;- 更新 sensor_info_msg_&lt;br&gt;- 同时为里程融合保留 GNSS 最近有效输入" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#26A69A;fillColor=#E8F7F5;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="470" y="750" width="300" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_mileage" value="&lt;b&gt;5. ptm 里程融合&lt;/b&gt;&lt;br&gt;src/pixmoving_mileage.cpp&lt;br&gt;&lt;br&gt;- NDT -&gt; GNSS -&gt; chassis speed 三层回退&lt;br&gt;- freshness / warmup / jump reject / speed gate&lt;br&gt;- syncPowerCycleResetByRawTrip() 保持上电语义&lt;br&gt;- save / restore snapshot，最终写回 VehicleInfo.ptm" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FB8C00;fillColor=#FFF5E8;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="805" y="750" width="300" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_metrics" value="&lt;b&gt;6. PlanningMetricsMonitor&lt;/b&gt;&lt;br&gt;planning_metrics_monitor.cpp/hpp&lt;br&gt;&lt;br&gt;- 独立订阅 /planning/planning_evaluator/metrics&lt;br&gt;- 提取舒适性 + 稳定性指标&lt;br&gt;- 事件驱动发布 /app/cloud_control_platform/planning_metrics" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3949AB;fillColor=#E9EDFF;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="750" width="300" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="rt_core_publish" value="&lt;b&gt;7. 统一缓存 + 发布策略&lt;/b&gt;&lt;br&gt;主要缓存：vehicle_info_msg_ / sensor_info_msg_ / autoware_info_msg_ / v2d_current_station_info_msg_ / task_semantic_status_msg_&lt;br&gt;&lt;br&gt;- onTimer(): 发布 all_station / v2d_vehicle_info / sensor_info / autoware_info / task_semantic_status / vehicle_info&lt;br&gt;- current_station_info: 在 DRIVING / ARRIVED / WAITING_FOR_ENGAGE / PLANNING 这些关键状态变化时发布&lt;br&gt;- nearby_finish: 在 mode 变化时即时发布&lt;br&gt;- vehicle_info 受 live-source ready mask 保护，并每 2s 落 snapshot" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#546E7A;fillColor=#ECEFF1;strokeWidth=2;fontSize=17;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1040" width="970" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="rt_output_frame" value="输出与消费面" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B0BEC5;fillColor=#F8FBFF;strokeWidth=2;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=18;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1550" y="120" width="520" height="1150" as="geometry"/>
                </mxCell>
                <mxCell id="rt_output_hmi" value="&lt;b&gt;HMI 展示主题&lt;/b&gt;&lt;br&gt;/app/display/vehicle_info&lt;br&gt;/app/display/all_station_info&lt;br&gt;/app/display/current_station_info&lt;br&gt;/app/display/debug/task_semantic_status&lt;br&gt;&lt;br&gt;用于前端展示底盘信息、站点信息和语义调试" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E7D32;fillColor=#E8F5E9;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1580" y="200" width="460" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="rt_output_cloud" value="&lt;b&gt;云控 / 业务主题&lt;/b&gt;&lt;br&gt;/app/cloud_control_platform/vehicle_info&lt;br&gt;/app/cloud_control_platform/sensor_info&lt;br&gt;/app/cloud_control_platform/autoware_info&lt;br&gt;/app/cloud_control_platform/planning_metrics&lt;br&gt;/app/cloud_control_platform/nearby_finish&lt;br&gt;&lt;br&gt;由 central business / analysis / mqtt / zenoh bridge 等下游消费" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#00897B;fillColor=#E0F4F1;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1580" y="480" width="460" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="rt_output_debug" value="&lt;b&gt;调试 / 语义结果&lt;/b&gt;&lt;br&gt;- mode / nearby_finish / task_terminal / planning_metrics&lt;br&gt;- route station service 与 pose fallback 的日志&lt;br&gt;- mileage source switch / snapshot save / restore 日志&lt;br&gt;- use_state_machine_drive_mode 允许回退旧逻辑&lt;br&gt;&lt;br&gt;一句话：这个包不是简单转发器，而是“底盘/HMI 语义聚合层”" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#607D8B;fillColor=#F5F7FA;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacing=14;fontFamily=Noto Sans JP;" parent="1" vertex="1">
                    <mxGeometry x="1580" y="820" width="460" height="260" as="geometry"/>
                </mxCell>
