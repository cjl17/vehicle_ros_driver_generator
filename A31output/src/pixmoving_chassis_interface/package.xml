<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pixmoving_chassis_interface</name>
  <version>0.0.0</version>
  <description>Chassis and vehicle-state interface package for RoboBus HMI integration.</description>
  <maintainer email="hongli.luo@pixmoving.net">Hongli Luo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>get_osm_info_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>autoware_system_msgs</depend>
  <depend>autoware_internal_planning_msgs</depend>
  <depend>autoware_internal_msgs</depend>
  <depend>tier4_debug_msgs</depend>
  <depend>autoware_internal_debug_msgs</depend>
  <depend>pixmoving_hmi_msgs</depend>
  <depend>pix_robobus_driver</depend>
  <depend>pix_robobus_driver_msgs</depend>
  <depend>cloud_control_platform_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tier4_metric_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>tier4_external_api_msgs</depend>
  <depend>autoware_adapi_v1_msgs</depend>
  <depend>aeb_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
