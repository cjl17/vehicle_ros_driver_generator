<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robobus_hmi_data_relay</name>
  <version>0.1.0</version>
  <description>Unified RoboBus HMI relay package with shared modules, one primary launch entry, and centralized parameters.</description>
  <maintainer email="hongli.luo@pixmoving.net">Hongli Luo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>autoware_system_msgs</depend>
  <depend>autoware_internal_planning_msgs</depend>
  <depend>autoware_internal_debug_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pixmoving_hmi_msgs</depend>
  <depend>pix_robobus_driver_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tier4_vehicle_msgs</depend>
  <depend>tier4_external_api_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
